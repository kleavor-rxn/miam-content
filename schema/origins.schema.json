{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miam.raxoon.com/schema/origins.schema.json",
  "type": "object",
  "required": ["schemaVersion", "regions", "countries"],
  "properties": {
    "schemaVersion": {"const": 1},
    "regions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "names"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "names": {"$ref": "recipe.schema.json#/$defs/localizedText"}
        },
        "additionalProperties": false
      }
    },
    "countries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "names", "region", "latitude", "longitude"],
        "properties": {
          "code": {"type": "string", "pattern": "^[A-Z]{2}$"},
          "names": {"$ref": "recipe.schema.json#/$defs/localizedText"},
          "region": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "latitude": {"type": "number", "minimum": -90, "maximum": 90},
          "longitude": {"type": "number", "minimum": -180, "maximum": 180}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
