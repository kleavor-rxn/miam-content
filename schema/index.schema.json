{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miam.raxoon.com/schema/index.schema.json",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "recipes", "dailyPicks"],
  "properties": {
    "schemaVersion": {"const": 1},
    "generatedAt": {"type": "string", "format": "date-time"},
    "recipes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "updatedAt", "contentHash", "title", "heroImage",
                     "tags", "totalMinutes", "difficulty"],
        "properties": {
          "id": {"type": "string"},
          "updatedAt": {"type": "string", "format": "date-time"},
          "contentHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "title": {"$ref": "recipe.schema.json#/$defs/localizedText"},
          "heroImage": {"type": "string"},
          "tags": {"type": "array", "items": {"type": "string"}},
          "totalMinutes": {"type": "integer", "minimum": 1},
          "difficulty": {"type": "integer", "minimum": 1, "maximum": 3}
        },
        "additionalProperties": false
      }
    },
    "dailyPicks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["date", "recipeID"],
        "properties": {
          "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "recipeID": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
