{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miam.raxoon.com/schema/occasions.schema.json",
  "type": "object",
  "required": ["schemaVersion", "occasions"],
  "properties": {
    "schemaVersion": {"const": 1},
    "occasions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "names"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "names": {"$ref": "recipe.schema.json#/$defs/localizedText"},
          "windows": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["start", "end"],
              "properties": {
                "start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
                "end": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
